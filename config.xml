<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yiyu.workbench" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>一隅</name>
    <description>个人工作台 - 记账/国学经典/幼儿启蒙/英语学习</description>
    <author email="dev@yiyu.app" href="https://yiyu.app">YiYu</author>
    <content src="index.html" />

    <!-- 允许访问所有外部资源（WebView 内部） -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Android 配置 -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="AndroidInsecureFileModeEnabled" value="false" />
        <preference name="android-compileSdkVersion" value="34" />
        <preference name="BackgroundColor" value="0xfff5f3ec" />
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarBackgroundColor" value="#f5f3ec" />
        <preference name="StatusBarStyle" value="default" />

        <!-- 图标（构建时自动生成，此处声明路径） -->
        <icon src="res/icon/android/icon-ldpi.png" density="ldpi" />
        <icon src="res/icon/android/icon-mdpi.png" density="mdpi" />
        <icon src="res/icon/android/icon-hdpi.png" density="hdpi" />
        <icon src="res/icon/android/icon-xhdpi.png" density="xhdpi" />
        <icon src="res/icon/android/icon-xxhdpi.png" density="xxhdpi" />
        <icon src="res/icon/android/icon-xxxhdpi.png" density="xxxhdpi" />
    </platform>

    <!-- 核心插件 -->
    <plugin name="cordova-plugin-statusbar" spec="^4.0.0" />
    <plugin name="cordova-plugin-device" spec="^3.0.0" />
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />

    <!-- 允许导航和内容加载 -->
    <allow-navigation href="*" />
</widget>
