.hero { padding: 40rpx 32rpx 8rpx; }
.hero-top { display: flex; justify-content: space-between; align-items: flex-start; }
.hero-date { font-size: 24rpx; color: var(--muted); }
.hero-title { font-size: 40rpx; font-weight: 800; margin-top: 8rpx; letter-spacing: 2rpx; }
.theme-btn { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--surface); border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 34rpx; }

.quote-card {
  margin-top: 28rpx;
  background: linear-gradient(135deg, var(--surface), var(--surface2));
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 30rpx;
  box-shadow: var(--shadow-sm);
}
.quote-text { font-size: 30rpx; font-weight: 600; line-height: 1.7; }
.quote-src { font-size: 22rpx; color: var(--muted); margin-top: 12rpx; text-align: right; }

.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx; padding: 32rpx 24rpx 8rpx; }
.quick-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 24rpx 0; background: var(--surface); border-radius: var(--radius); border: 1rpx solid var(--line); box-shadow: var(--shadow-sm); font-size: 24rpx; color: var(--ink-2); }
.quick-hover { transform: scale(.95); opacity: .85; }
.q-icon { width: 88rpx; height: 88rpx; border-radius: 24rpx; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; }

.stat-row { display: flex; }
.stat { flex: 1; text-align: center; padding: 16rpx 0; }
.stat-num { font-size: 44rpx; font-weight: 800; color: var(--red); }
.stat-label { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
