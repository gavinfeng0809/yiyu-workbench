.py-sec { padding: 20rpx 24rpx 10rpx; }
.py-title { font-size: 28rpx; font-weight: 700; display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; }
.dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }
.py-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18rpx; }
.py-card { background: var(--surface); border: 1rpx solid var(--line); border-radius: var(--radius-sm); padding: 22rpx 12rpx; text-align: center; box-shadow: var(--shadow-sm); }
.py-card.v { border-left: 6rpx solid var(--red); }
.py-card.d { border-left: 6rpx solid var(--accent); }
.py-card.c { border-left: 6rpx solid var(--blue); }
.py-card:active { transform: scale(.94); }
.py-sym { font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.py-ex { font-size: 22rpx; color: var(--ink-2); margin-top: 6rpx; }
.py-mouth { font-size: 20rpx; color: var(--muted); margin-top: 8rpx; line-height: 1.5; }
.tip { text-align: center; color: var(--muted); font-size: 22rpx; padding: 30rpx; }
