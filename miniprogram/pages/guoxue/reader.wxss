.toolbar {
  position: sticky; top: 0; z-index: 10;
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 24rpx;
  background: var(--bg);
}
.tool-group { display: flex; gap: 12rpx; }
.tool-btn {
  min-width: 72rpx; height: 64rpx; padding: 0 16rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 14rpx; font-size: 26rpx;
  background: var(--surface); border: 1rpx solid var(--line); color: var(--ink-2);
}
.tool-btn.on { color: var(--red); border-color: var(--red); background: rgba(181, 84, 45, .08); }
.tool-btn.active { color: var(--ink); border-color: var(--muted); }
.tool-btn:active { transform: scale(.92); }

.head { text-align: center; }
.h-title { font-size: 38rpx; font-weight: 800; letter-spacing: 4rpx; }
.h-author { font-size: 24rpx; color: var(--muted); margin-top: 10rpx; }
.h-intro { font-size: 24rpx; color: var(--ink-2); margin-top: 16rpx; line-height: 1.7; }

.body { padding: 10rpx 32rpx 60rpx; }
.line { padding: 14rpx 0; border-bottom: 1rpx dashed var(--line); }
.line-t { font-size: 36rpx; line-height: 1.9; letter-spacing: 1rpx; }
.line-p { font-size: 22rpx; color: var(--muted); line-height: 1.7; margin-top: 4rpx; }
