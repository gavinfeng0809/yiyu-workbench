.hanzi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx; padding: 0 24rpx; }
.hz-card {
  position: relative;
  background: var(--surface); border: 1rpx solid var(--line); border-radius: var(--radius);
  padding: 24rpx 8rpx; text-align: center; box-shadow: var(--shadow-sm);
  transition: all .2s;
}
.hz-card:active { transform: scale(.94); }
.hz-card.done { border-color: var(--green); background: rgba(120, 140, 93, .1); }
.hz-char { font-size: 56rpx; font-weight: 700; line-height: 1.3; }
.hz-pin { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.hz-w { font-size: 20rpx; color: var(--ink-2); margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hz-tick { position: absolute; top: 8rpx; right: 12rpx; color: var(--green); font-size: 28rpx; font-weight: 700; }

.num-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx; padding: 0 24rpx; }
.num-card { background: var(--surface); border-radius: var(--radius); border: 1rpx solid var(--line); padding: 20rpx 8rpx; text-align: center; box-shadow: var(--shadow-sm); }
.num-big { font-size: 44rpx; font-weight: 800; color: var(--red); }
.num-en { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }

.color-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; padding: 0 24rpx; }
.color-card { background: var(--surface); border-radius: var(--radius); border: 1rpx solid var(--line); padding: 20rpx; text-align: center; box-shadow: var(--shadow-sm); }
.color-swatch { width: 72rpx; height: 72rpx; border-radius: 50%; margin: 0 auto 12rpx; border: 2rpx solid rgba(0, 0, 0, .08); }
.color-name { font-size: 28rpx; font-weight: 700; }
.color-pin { font-size: 22rpx; color: var(--muted); }
.color-en { font-size: 22rpx; color: var(--ink-2); }

.py-section { }
.py-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.py-item { padding: 12rpx 22rpx; background: var(--surface2); border-radius: 12rpx; font-size: 28rpx; color: var(--ink-2); border: 1rpx solid var(--line); }
