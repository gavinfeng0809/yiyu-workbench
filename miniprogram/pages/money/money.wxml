<view class="page {{theme}}">
  <!-- 月度汇总 -->
  <view class="card summary">
    <view class="s-month">{{monthStr}}</view>
    <view class="s-balance">¥ {{balance}}</view>
    <view class="s-label">本月结余</view>
    <view class="s-row">
      <view class="s-cell">
        <view class="s-num in">+¥ {{income}}</view>
        <view class="s-lb">收入</view>
      </view>
      <view class="s-cell">
        <view class="s-num out">-¥ {{expense}}</view>
        <view class="s-lb">支出</view>
      </view>
    </view>
  </view>

  <!-- 快捷记账 -->
  <view class="quick-add">
    <view class="qa-btn in" bindtap="openForm" data-type="in">+ 收入</view>
    <view class="qa-btn out" bindtap="openForm" data-type="out">- 支出</view>
  </view>

  <!-- 明细 -->
  <view class="card" wx:if="{{list.length}}">
    <view class="card-title">最近明细</view>
    <view class="rec" wx:for="{{list}}" wx:key="id">
      <view class="rec-cat">{{item.cat}}</view>
      <view class="rec-note">{{item.note || item.date}}</view>
      <view class="rec-amt {{item.type === 'in' ? 'in' : 'out'}}">{{item.type === 'in' ? '+' : '-'}}{{item.amount}}</view>
      <view class="rec-del" catchtap="del" data-id="{{item.id}}">×</view>
    </view>
  </view>
  <view class="empty" wx:else>本月还没有记录，点上方按钮记一笔</view>

  <!-- 表单弹层 -->
  <view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
    <view class="form" catchtap="noop">
      <view class="f-title">记一笔</view>
      <view class="f-type">
        <view class="ft-btn {{formType === 'out' ? 'on out' : ''}}" bindtap="setType" data-type="out">支出</view>
        <view class="ft-btn {{formType === 'in' ? 'on in' : ''}}" bindtap="setType" data-type="in">收入</view>
      </view>
      <view class="f-cats">
        <view wx:for="{{formType === 'in' ? inCats : outCats}}" wx:key="*this"
          class="f-cat {{catIndex === index ? 'on' : ''}}" data-i="{{index}}" bindtap="setCat">{{item}}</view>
      </view>
      <view class="f-amount">
        <text class="fa-sym">¥</text>
        <input type="digit" placeholder="0.00" value="{{amount}}" bindinput="inputAmount" class="fa-input" />
      </view>
      <view class="f-note">
        <input placeholder="备注（可选）" value="{{note}}" bindinput="inputNote" class="fni" />
        <picker mode="date" value="{{date}}" bindchange="inputDate">
          <view class="fp-date">{{date}}</view>
        </picker>
      </view>
      <view class="f-save btn primary" bindtap="save">保存</view>
    </view>
  </view>
</view>
