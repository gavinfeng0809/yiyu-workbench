.summary { text-align: center; }
.s-month { font-size: 24rpx; color: var(--muted); }
.s-balance { font-size: 72rpx; font-weight: 800; margin: 12rpx 0 4rpx; letter-spacing: 1rpx; }
.s-label { font-size: 24rpx; color: var(--muted); }
.s-row { display: flex; margin-top: 30rpx; border-top: 1rpx solid var(--line); padding-top: 24rpx; }
.s-cell { flex: 1; }
.s-num { font-size: 34rpx; font-weight: 700; }
.s-num.in { color: var(--green); }
.s-num.out { color: var(--red); }
.s-lb { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }

.quick-add { display: flex; gap: 20rpx; padding: 0 24rpx 24rpx; }
.qa-btn { flex: 1; text-align: center; padding: 26rpx 0; border-radius: var(--radius); color: #fff; font-size: 30rpx; font-weight: 700; }
.qa-btn.in { background: linear-gradient(135deg, #8aa86f, #788c5d); }
.qa-btn.out { background: linear-gradient(135deg, #e07a52, #b5542d); }
.qa-btn:active { transform: scale(.97); }

.rec { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.rec:last-child { border-bottom: none; }
.rec-cat { font-size: 26rpx; font-weight: 600; background: var(--surface2); padding: 8rpx 18rpx; border-radius: 12rpx; }
.rec-note { flex: 1; font-size: 24rpx; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rec-amt { font-size: 28rpx; font-weight: 700; }
.rec-amt.in { color: var(--green); }
.rec-amt.out { color: var(--red); }
.rec-del { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 32rpx; }

.mask { position: fixed; inset: 0; background: rgba(0, 0, 0, .45); z-index: 100; display: flex; align-items: flex-end; }
.form { width: 100%; background: var(--surface); border-radius: 32rpx 32rpx 0 0; padding: 40rpx 32rpx 60rpx; }
.f-title { font-size: 34rpx; font-weight: 800; text-align: center; margin-bottom: 24rpx; }
.f-type { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.ft-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 14rpx; border: 1rpx solid var(--line); color: var(--ink-2); }
.ft-btn.on.out { background: var(--red); color: #fff; border-color: var(--red); }
.ft-btn.on.in { background: var(--green); color: #fff; border-color: var(--green); }
.f-cats { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 24rpx; }
.f-cat { padding: 12rpx 26rpx; border-radius: 999rpx; font-size: 24rpx; background: var(--surface2); border: 1rpx solid var(--line); color: var(--ink-2); }
.f-cat.on { background: var(--red); color: #fff; border-color: var(--red); }
.f-amount { display: flex; align-items: center; background: var(--surface2); border-radius: 14rpx; padding: 0 24rpx; margin-bottom: 20rpx; }
.fa-sym { font-size: 40rpx; font-weight: 700; color: var(--muted); }
.fa-input { flex: 1; font-size: 44rpx; padding: 20rpx 0 20rpx 16rpx; font-weight: 700; }
.f-note { display: flex; align-items: center; gap: 16rpx; background: var(--surface2); border-radius: 14rpx; padding: 0 24rpx; margin-bottom: 32rpx; }
.fni { flex: 1; font-size: 28rpx; padding: 18rpx 0; }
.fp-date { font-size: 26rpx; color: var(--ink-2); padding: 18rpx 0; }
.f-save { width: 100%; }
