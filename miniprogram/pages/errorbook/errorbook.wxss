.err-list { padding: 0 24rpx; }
.e-top { display: flex; align-items: baseline; gap: 16rpx; }
.e-word { font-size: 36rpx; font-weight: 800; color: var(--red); }
.e-phon { font-size: 26rpx; color: var(--muted); }
.e-mean { font-size: 26rpx; color: var(--ink-2); margin-top: 6rpx; }
.e-meta { font-size: 20rpx; color: var(--muted); margin-top: 6rpx; }
.e-actions { display: flex; gap: 14rpx; flex: none; }
.e-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--surface2); border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.e-btn.ok { color: var(--green); border-color: var(--green); }
.e-btn.del { color: var(--red); border-color: var(--red); }
.e-btn:active { transform: scale(.9); }
.err-toolbar { display: flex; gap: 20rpx; padding: 30rpx 24rpx; }
.err-toolbar .btn { flex: 1; }
